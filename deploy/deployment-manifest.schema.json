{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "network", "sourceCommit", "artifactManifestDigest", "contract", "address", "codeHash", "dataHash", "verifiedAt", "activeState", "balanceNano", "storageMarginNano", "transaction", "providers", "canary"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "network": { "enum": ["testnet", "mainnet"] },
    "sourceCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "artifactManifestDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contract": { "type": "string" },
    "address": { "type": "string" },
    "codeHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "dataHash": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "verifiedAt": { "type": "string", "format": "date-time" },
    "activeState": { "const": "active" },
    "balanceNano": { "type": "string", "pattern": "^[0-9]+$" },
    "storageMarginNano": { "type": "string", "pattern": "^[0-9]+$" },
    "transaction": {
      "type": "object",
      "required": ["hash", "lt"],
      "properties": { "hash": { "type": "string", "minLength": 1 }, "lt": { "type": "string", "minLength": 1 }, "block": { "type": "string" } },
      "additionalProperties": true
    },
    "providers": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 1 } },
    "canary": {
      "type": "object",
      "required": ["validProofAccepted", "invalidPolicyRejected", "replayRejected"],
      "properties": { "validProofAccepted": { "const": true }, "invalidPolicyRejected": { "const": true }, "replayRejected": { "const": true } },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
