{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schemaVersion", "type", "status", "toolchain", "circuits"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "type": { "const": "zk-tele-auth-artifact-manifest" },
    "status": { "enum": ["development-only", "production-pending-attestation", "production-approved", "revoked"] },
    "toolchain": { "type": "object", "additionalProperties": { "type": "string" } },
    "circuits": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status", "circuitVersion", "curve", "constraints", "publicSignals", "files", "runtimeFiles"],
        "properties": {
          "status": { "enum": ["development-only", "production-pending-attestation", "production-approved", "revoked"] },
          "circuitVersion": { "type": "integer", "minimum": 1 },
          "curve": { "type": "string" },
          "constraints": { "type": "integer", "minimum": 0 },
          "publicSignals": { "type": "integer", "minimum": 0 },
          "files": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
          "runtimeFiles": { "type": "object", "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
        }
      }
    }
  }
}
