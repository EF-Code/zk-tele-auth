{
  "name": "zk-tele-auth",
  "version": "2.0.0",
  "description": "Zero-Knowledge Authentication & Identity Attestation Protocol for Telegram and Web3 dApps",
  "main": "dist/sdk/index.js",
  "types": "dist/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./gateway": {
      "types": "./dist/gateway/server.d.ts",
      "import": "./dist/gateway/server.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "artifacts/*/*.wasm",
    "artifacts/*/*_final.zkey",
    "artifacts/*/*_vkey.json",
    "artifacts/manifest.json",
    "contracts/",
    "circuits/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20 <27",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "node scripts/run-tests.mjs && node scripts/check-ton-contract.mjs && node scripts/check-priva-purchase-contract.mjs && node tests/ton-contract-tests.mjs && node tests/gateway-hardening-tests.mjs && node tests/attestation-tests.mjs",
    "check:priva-artifacts": "node scripts/check-priva-artifact-provenance.mjs",
    "check:priva-production": "node scripts/check-production-attestation.mjs",
    "artifacts:manifest:write": "node scripts/check-artifact-manifest.mjs --write",
    "artifacts:manifest:check": "node scripts/check-artifact-manifest.mjs",
    "artifacts:verify:production": "node scripts/check-production-attestation.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "package:consumer-smoke": "npm run build && node tests/package-consumer-smoke.mjs",
    "start:gateway": "node dist/gateway/main.js",
    "deploy:dry-run": "npm run build && node scripts/deploy-ton.mjs --network testnet --dry-run",
    "deploy:verify-manifest": "node scripts/verify-ton-deployment.mjs",
    "setup:circuits": "node scripts/setup-circuits.cjs",
    "compile-circuits": "node scripts/setup-circuits.cjs"
  },
  "keywords": [
    "zero-knowledge",
    "zk-snark",
    "circom",
    "groth16",
    "telegram",
    "web3",
    "ton",
    "oauth",
    "privacy",
    "nullifier"
  ],
  "author": "ef-code",
  "license": "MIT",
  "dependencies": {
    "@ton/core": "^0.63.1",
    "circomlib": "^2.0.5",
    "poseidon-bls12381": "1.0.2",
    "poseidon-bls12381-circom": "1.0.0",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "@ton/sandbox": "^0.44.0",
    "@ton/tolk-js": "^1.4.2",
    "@types/node": "^26.1.2",
    "export-ton-verifier": "^3.0.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "underscore": "^1.13.8"
  },
  "type": "module"
}
