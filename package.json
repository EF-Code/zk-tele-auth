{
  "name": "zk-tele-auth",
  "version": "2.0.0",
  "description": "Zero-Knowledge Authentication & Identity Attestation Protocol for Telegram and Web3 dApps",
  "repository": {
    "type": "git",
    "url": "https://github.com/EF-Code/zk-tele-auth.git"
  },
  "bugs": {
    "url": "https://github.com/EF-Code/zk-tele-auth/issues"
  },
  "homepage": "https://github.com/EF-Code/zk-tele-auth#readme",
  "main": "dist/sdk/index.js",
  "types": "dist/sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/sdk/index.d.ts",
      "import": "./dist/sdk/index.js"
    },
    "./gateway": {
      "types": "./dist/gateway/server.d.ts",
      "import": "./dist/gateway/server.js"
    },
    "./gateway/config": {
      "types": "./dist/gateway/config.d.ts",
      "import": "./dist/gateway/config.js"
    },
    "./gateway/secrets": {
      "types": "./dist/gateway/secrets.d.ts",
      "import": "./dist/gateway/secrets.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client/index.js"
    },
    "./ton": {
      "types": "./dist/sdk/ton.d.ts",
      "import": "./dist/sdk/ton.js"
    },
    "./membership": {
      "types": "./dist/sdk/membership.d.ts",
      "import": "./dist/sdk/membership.js"
    },
    "./experimental/priva": {
      "types": "./dist/sdk/experimental/priva.d.ts",
      "import": "./dist/sdk/experimental/priva.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "artifacts/telegram_auth/telegram_auth.wasm",
    "artifacts/telegram_auth/telegram_auth_final.zkey",
    "artifacts/telegram_auth/telegram_auth_vkey.json",
    "artifacts/priva_purchase_auth/priva_purchase_auth.wasm",
    "artifacts/priva_purchase_auth/priva_purchase_auth_final.zkey",
    "artifacts/priva_purchase_auth/priva_purchase_auth_vkey.json",
    "artifacts/membership/membership.wasm",
    "artifacts/membership/membership_final.zkey",
    "artifacts/membership/membership_vkey.json",
    "artifacts/manifest.json",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20 <27",
    "npm": ">=10"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "tsc -p tsconfig.json",
    "test": "node scripts/run-tests.mjs && node scripts/check-ton-contract.mjs && node scripts/check-priva-purchase-contract.mjs && node tests/ton-contract-tests.mjs && node tests/priva-launchpad-tests.mjs && node tests/deployment-profile-tests.mjs && node tests/gateway-hardening-tests.mjs && node tests/attestation-tests.mjs",
    "check:priva-artifacts": "node scripts/check-priva-artifact-provenance.mjs",
    "check:priva-production": "node scripts/check-production-attestation.mjs",
    "check:priva-composition": "node scripts/check-priva-composition.mjs",
    "artifacts:manifest:write": "node scripts/check-artifact-manifest.mjs --write",
    "artifacts:manifest:check": "node scripts/check-artifact-manifest.mjs",
    "artifacts:verify:production": "node scripts/check-production-attestation.mjs",
    "artifacts:verify:dev": "node scripts/verify-development-artifacts.mjs",
    "artifacts:import:production": "node scripts/import-production-artifacts.mjs",
    "release:preflight": "node scripts/release-preflight.mjs",
    "package:consumer-smoke": "npm run build && node tests/package-consumer-smoke.mjs",
    "test:client": "npm run build && node tests/client-tests.mjs",
    "test:openapi": "node tests/openapi-tests.mjs",
    "test:ton-consumer": "npm run build && node tests/ton-consumer-tests.mjs",
    "test:examples": "npm run build && node tests/example-tests.mjs",
    "test:exports": "npm run build && node tests/exports-tests.mjs",
    "test:deployment-templates": "node scripts/validate-deployment-templates.mjs",
    "test:gateway-workers": "npm run build && node tests/gateway-workers-tests.mjs",
    "package:content-check": "npm run build && node scripts/package-content-check.mjs",
    "supply-chain:hooks": "node scripts/supply-chain-hooks.mjs",
    "sbom:package": "node scripts/supply-chain-hooks.mjs",
    "sbom:package:required": "RELEASE_REQUIRED_TOOLS=1 node scripts/supply-chain-hooks.mjs",
    "start:gateway": "node dist/gateway/main.js",
    "deploy:dry-run": "npm run build && node scripts/deploy-ton.mjs --network testnet --dry-run",
    "compile:ton": "node scripts/compile-ton-contracts.mjs",
    "deploy:verify-manifest": "node scripts/verify-ton-deployment.mjs",
    "setup:circuits": "node scripts/setup-circuits.cjs",
    "compile-circuits": "node scripts/setup-circuits.cjs"
  },
  "keywords": [
    "zero-knowledge",
    "zk-snark",
    "circom",
    "groth16",
    "telegram",
    "web3",
    "ton",
    "oauth",
    "privacy",
    "nullifier"
  ],
  "author": "ef-code",
  "license": "MIT",
  "dependencies": {
    "@ton/core": "^0.63.1",
    "circomlib": "^2.0.5",
    "poseidon-bls12381": "1.0.2",
    "poseidon-bls12381-circom": "1.0.0",
    "export-ton-verifier": "^3.0.2",
    "snarkjs": "^0.7.6"
  },
  "devDependencies": {
    "@ton/sandbox": "^0.44.0",
    "@ton/tolk-js": "^1.4.2",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "underscore": "^1.13.8"
  },
  "type": "module"
}
