import "@stdlib/exotic-cells"

contract PrivaPurchaseAuthVerifier {
    description: "Groth16 verifier generated by export-ton-verifier"
    storage: PrivaPurchaseAuthVerifierStorage
    incomingMessages: PrivaPurchaseAuthVerifierVerify
}

/// This verifier is stateless.
/// It does not provide:
/// - nullifier replay protection;
/// - nonce or query-id protection;
/// - known-root validation;
/// - recipient binding;
/// - chain-id or contract-address domain separation;
/// - state-transition validation.

/// Empty persistent storage; verifier constants are embedded in code.
struct PrivaPurchaseAuthVerifierStorage {}

struct PrivaPurchaseAuthVerifier {
    ic0: slice
    ic1: slice
    ic2: slice
    ic3: slice
    ic4: slice
    ic5: slice
    ic6: slice
    ic7: slice
    ic8: slice
    ic9: slice
    ic10: slice
    ic11: slice
    ic12: slice
    ic13: slice
    ic14: slice
    ic15: slice
    ic16: slice
    ic17: slice
    vkGamma2: slice
    vkDelta2: slice
    vkAlpha1: slice
    vkBeta2: slice
    nPublic: int
}

const PRIVA_PURCHASE_AUTH_VERIFIER_MIN_VERIFY_VALUE: coins = 50000000

enum PrivaPurchaseAuthVerifierErrors {
    InvalidInputs = 258
    IndexOutOfRange = 259
    WrongProof = 260
    NotEnoughValue = 261
}

