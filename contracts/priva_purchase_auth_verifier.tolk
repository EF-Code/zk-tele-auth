/// # Safety
/// Expects both slices to contain canonically encoded BLS12-381 G1 points
/// accepted by the TVM `BLS_G1_ADD` opcode.
@pure
fun PrivaPurchaseAuthVerifier.blsG1Add(x: slice, y: slice): slice
    asm "BLS_G1_ADD"

/// # Safety
/// Expects the slice to contain a canonically encoded BLS12-381 G1 point
/// accepted by the TVM `BLS_G1_NEG` opcode.
@pure
fun PrivaPurchaseAuthVerifier.blsG1Neg(x: slice): slice
    asm "BLS_G1_NEG"

/// # Safety
/// The caller supplies a canonical 384-bit G1 encoding that has already passed
/// the proof cell shape checks enforced by `loadCheckedG1`.
@pure
fun PrivaPurchaseAuthVerifier.blsG1InGroup(x: slice): bool
    asm "BLS_G1_INGROUP"

/// # Safety
/// The caller supplies a canonical 768-bit G2 encoding that has already passed
/// the proof cell shape checks enforced by `loadCheckedG2`.
@pure
fun PrivaPurchaseAuthVerifier.blsG2InGroup(x: slice): bool
    asm "BLS_G2_INGROUP"

/// # Safety
/// The caller supplies a canonical 384-bit G1 encoding checked for exact shape
/// before this helper is invoked.
@pure
fun PrivaPurchaseAuthVerifier.blsG1IsZero(x: slice): bool
    asm "BLS_G1_ISZERO"

/// # Safety
/// The caller supplies a canonical 768-bit G2 encoding checked for exact shape
/// before this helper is invoked.
@pure
fun PrivaPurchaseAuthVerifier.blsG2IsZero(x: slice): bool
    asm "BLS_G2_ISZERO"

fun PrivaPurchaseAuthVerifier.checkProofPoints(piA: slice, piB: slice, piC: slice) {
    if (
        piA.remainingBitsCount() != 384 || piA.remainingRefsCount() != 0 ||
        piB.remainingBitsCount() != 768 ||
        piB.remainingRefsCount() != 0 ||
        piC.remainingBitsCount() != 384 ||
        piC.remainingRefsCount() != 0
    ) {
        throw PrivaPurchaseAuthVerifierErrors.InvalidInputs;
    }
    if (
        !PrivaPurchaseAuthVerifier.blsG1InGroup(piA) ||
        !PrivaPurchaseAuthVerifier.blsG2InGroup(piB) ||
        !PrivaPurchaseAuthVerifier.blsG1InGroup(piC)
    ) {
        throw PrivaPurchaseAuthVerifierErrors.InvalidInputs;
    }
    if (
        PrivaPurchaseAuthVerifier.blsG1IsZero(piA) || PrivaPurchaseAuthVerifier.blsG2IsZero(piB) ||
        PrivaPurchaseAuthVerifier.blsG1IsZero(piC)
    ) {
        throw PrivaPurchaseAuthVerifierErrors.InvalidInputs;
    }
}

fun PrivaPurchaseAuthVerifier.loadCheckedG1(point: cell): slice {
    val (pointSlice, isExotic) = point.beginParseSpecial();
    if (
        isExotic || pointSlice.remainingBitsCount() != 384 || pointSlice.remainingRefsCount() != 0
    ) {
        throw PrivaPurchaseAuthVerifierErrors.InvalidInputs;
    }
    return pointSlice;
}

fun PrivaPurchaseAuthVerifier.loadCheckedG2(point: cell): slice {
    val (pointSlice, isExotic) = point.beginParseSpecial();
    if (
        isExotic || pointSlice.remainingBitsCount() != 768 || pointSlice.remainingRefsCount() != 0
    ) {
        throw PrivaPurchaseAuthVerifierErrors.InvalidInputs;
    }
    return pointSlice;
}

fun PrivaPurchaseAuthVerifier.loadCheckedProof(proof: cell): (slice, slice, slice) {
    val (initialProof, isExotic) = proof.beginParseSpecial();
    var proofSlice = initialProof;
    if (isExotic || proofSlice.remainingBitsCount() != 0 || proofSlice.remainingRefsCount() != 3) {
        throw PrivaPurchaseAuthVerifierErrors.InvalidInputs;
    }
    val piA = PrivaPurchaseAuthVerifier.loadCheckedG1(proofSlice.loadRef());
    val piB = PrivaPurchaseAuthVerifier.loadCheckedG2(proofSlice.loadRef());
    val piC = PrivaPurchaseAuthVerifier.loadCheckedG1(proofSlice.loadRef());
    proofSlice.assertEnd();
    return (piA, piB, piC);
}

/// # Safety
/// `BLS_PUSHR` returns the VM's canonical BLS12-381 scalar-field modulus and
/// consumes no caller-provided stack values.
@pure
fun PrivaPurchaseAuthVerifier.blsR(): int
    asm "BLS_PUSHR"

fun PrivaPurchaseAuthVerifier.checkPublicInput(x: int): int {
    // TVM scalar multiplication reduces modulo r, so x and x+r would otherwise alias.
    if (x < 0 || x >= PrivaPurchaseAuthVerifier.blsR()) {
        throw PrivaPurchaseAuthVerifierErrors.InvalidInputs;
    }
    return x;
}

/// # Safety
/// Expects the provided slices to contain canonically encoded BLS12-381 proof
/// and verification-key points in the order required by TVM `BLS_PAIRING`.
@pure
fun PrivaPurchaseAuthVerifier.blsPairing(
    x1: slice,
    y1: slice,
    x2: slice,
    y2: slice,
    x3: slice,
    y3: slice,
    x4: slice,
    y4: slice,
    n: int,
): int
    asm "BLS_PAIRING"

/// # Safety
/// Expects x1..x7 to be canonical BLS12-381 G1 points and y1..y7
/// to be scalars encoded in the format expected by TVM `BLS_G1_MULTIEXP`.
@pure
fun PrivaPurchaseAuthVerifier.blsG1Multiexp7(
    x1: slice,
    y1: int,
    x2: slice,
    y2: int,
    x3: slice,
    y3: int,
    x4: slice,
    y4: int,
    x5: slice,
    y5: int,
    x6: slice,
    y6: int,
    x7: slice,
    y7: int,
    n: int,
): slice
    asm "BLS_G1_MULTIEXP"

/// # Safety
/// Expects x1..x3 to be canonical BLS12-381 G1 points and y1..y3
/// to be scalars encoded in the format expected by TVM `BLS_G1_MULTIEXP`.
@pure
fun PrivaPurchaseAuthVerifier.blsG1Multiexp3(
    x1: slice,
    y1: int,
    x2: slice,
    y2: int,
    x3: slice,
    y3: int,
    n: int,
): slice
    asm "BLS_G1_MULTIEXP"

// IC selector for runtime batching.
fun PrivaPurchaseAuthVerifier.ic(self, idx: int): slice {
    if (idx == 1) {
        return self.ic1;
    }
    if (idx == 2) {
        return self.ic2;
    }
    if (idx == 3) {
        return self.ic3;
    }
    if (idx == 4) {
        return self.ic4;
    }
    if (idx == 5) {
        return self.ic5;
    }
    if (idx == 6) {
        return self.ic6;
    }
    if (idx == 7) {
        return self.ic7;
    }
    if (idx == 8) {
        return self.ic8;
    }
    if (idx == 9) {
        return self.ic9;
    }
    if (idx == 10) {
        return self.ic10;
    }
    if (idx == 11) {
        return self.ic11;
    }
    if (idx == 12) {
        return self.ic12;
    }
    if (idx == 13) {
        return self.ic13;
    }
    if (idx == 14) {
        return self.ic14;
    }
    if (idx == 15) {
        return self.ic15;
    }
    if (idx == 16) {
        return self.ic16;
    }
    if (idx == 17) {
        return self.ic17;
    }
    throw PrivaPurchaseAuthVerifierErrors.IndexOutOfRange;
}

// Internal messages carry public inputs as a custom payload:
// uint8 length, then canonical three-int257 chunks chained through refs.
fun PrivaPurchaseAuthVerifier.checkPublicInputsPayloadShape(payload: slice) {
    var remaining: int = 17;

    while (remaining > 0) {
        var chunk: int = remaining;
        if (chunk > 3) {
            chunk = 3;
        }
        if (payload.remainingBitsCount() != chunk * 257) {
            throw PrivaPurchaseAuthVerifierErrors.InvalidInputs;
        }
        remaining -= chunk;

        if (remaining > 0) {
            if (payload.remainingRefsCount() != 1) {
                throw PrivaPurchaseAuthVerifierErrors.InvalidInputs;
            }
            val (nextPayload, isExotic) = payload.loadRef().beginParseSpecial();
            if (isExotic) {
                throw PrivaPurchaseAuthVerifierErrors.InvalidInputs;
            }
            payload = nextPayload;
        } else if (payload.remainingRefsCount() != 0) {
            throw PrivaPurchaseAuthVerifierErrors.InvalidInputs;
        }
    }
}

fun PrivaPurchaseAuthVerifier.loadNextPubInput(mutate payload: slice): int {
    if (payload.remainingBitsCount() < 257) {
        if (payload.remainingBitsCount() != 0 || payload.remainingRefsCount() != 1) {
            throw PrivaPurchaseAuthVerifierErrors.InvalidInputs;
        }
        val (nextPayload, isExotic) = payload.loadRef().beginParseSpecial();
        if (isExotic || nextPayload.remainingBitsCount() < 257) {
            throw PrivaPurchaseAuthVerifierErrors.InvalidInputs;
        }
        payload = nextPayload;
    }
    return PrivaPurchaseAuthVerifier.checkPublicInput(payload.loadInt(257));
}

fun PrivaPurchaseAuthVerifier.finishGroth16(
    self,
    piA: slice,
    piB: slice,
    piC: slice,
    acc: slice,
    haveAcc: bool,
): bool {
    // Final cpub = IC0 + acc (IC0 is always added exactly once)
    var cpub: slice;
    if (!haveAcc) {
        cpub = self.ic0;
    } else {
        cpub = PrivaPurchaseAuthVerifier.blsG1Add(acc, self.ic0);
    }

    // Pairing check: e(cpub, gamma) * e(-piA, piB) * e(piC, delta) * e(alpha, beta) == 1
    val piANeg: slice = PrivaPurchaseAuthVerifier.blsG1Neg(piA);
    val ok: int = PrivaPurchaseAuthVerifier.blsPairing(
        cpub,
        self.vkGamma2,
        piANeg,
        piB,
        piC,
        self.vkDelta2,
        self.vkAlpha1,
        self.vkBeta2,
        4,
    );

    return ok != 0;
}

fun PrivaPurchaseAuthVerifier.verifyPayload(
    self,
    piA: slice,
    piB: slice,
    piC: slice,
    mutate payload: slice,
): bool {
    PrivaPurchaseAuthVerifier.checkProofPoints(piA, piB, piC);

    // Compute: cpub = IC0 + sum(pubInputs[i] * IC(i+1))
    var haveAcc: bool = false;
    var acc: slice = self.ic0; // placeholder until haveAcc == true

    // Multiple 7-sized batches plus an optional tail.
    var done: int = 0;
    val rem: int = self.nPublic % 7;

    while (done + 7 <= self.nPublic) {
        val y1: int = PrivaPurchaseAuthVerifier.loadNextPubInput(mutate payload);
        val y2: int = PrivaPurchaseAuthVerifier.loadNextPubInput(mutate payload);
        val y3: int = PrivaPurchaseAuthVerifier.loadNextPubInput(mutate payload);
        val y4: int = PrivaPurchaseAuthVerifier.loadNextPubInput(mutate payload);
        val y5: int = PrivaPurchaseAuthVerifier.loadNextPubInput(mutate payload);
        val y6: int = PrivaPurchaseAuthVerifier.loadNextPubInput(mutate payload);
        val y7: int = PrivaPurchaseAuthVerifier.loadNextPubInput(mutate payload);
        val tmp: slice = PrivaPurchaseAuthVerifier.blsG1Multiexp7(
            self.ic(done + 1),
            y1,
            self.ic(done + 2),
            y2,
            self.ic(done + 3),
            y3,
            self.ic(done + 4),
            y4,
            self.ic(done + 5),
            y5,
            self.ic(done + 6),
            y6,
            self.ic(done + 7),
            y7,
            7,
        );

        if (!haveAcc) {
            acc = tmp;
            haveAcc = true;
        } else {
            acc = PrivaPurchaseAuthVerifier.blsG1Add(acc, tmp);
        }

        done += 7;
    }

    if (rem == 3) {
        val y1: int = PrivaPurchaseAuthVerifier.loadNextPubInput(mutate payload);
        val y2: int = PrivaPurchaseAuthVerifier.loadNextPubInput(mutate payload);
        val y3: int = PrivaPurchaseAuthVerifier.loadNextPubInput(mutate payload);
        val tail: slice = PrivaPurchaseAuthVerifier.blsG1Multiexp3(
            self.ic(done + 1),
            y1,
            self.ic(done + 2),
            y2,
            self.ic(done + 3),
            y3,
            3,
        );

        if (!haveAcc) {
            acc = tail;
            haveAcc = true;
        } else {
            acc = PrivaPurchaseAuthVerifier.blsG1Add(acc, tail);
        }

        done += 3;
    }

    if (payload.remainingBitsCount() != 0 || payload.remainingRefsCount() != 0) {
        throw PrivaPurchaseAuthVerifierErrors.InvalidInputs;
    }

    return self.finishGroth16(piA, piB, piC, acc, haveAcc);
}

fun PrivaPurchaseAuthVerifier.verify(
    self,
    piA: slice,
    piB: slice,
    piC: slice,
    pubInputs: array<int>,
): bool {
    PrivaPurchaseAuthVerifier.checkProofPoints(piA, piB, piC);
    if (pubInputs.size() != self.nPublic) {
        throw PrivaPurchaseAuthVerifierErrors.InvalidInputs;
    }

    // Compute: cpub = IC0 + sum(pubInputs[i] * IC(i+1))
    var haveAcc: bool = false;
    var acc: slice = self.ic0; // placeholder until haveAcc == true

    // Multiple 7-sized batches plus an optional tail.
    var done: int = 0;
    val rem: int = self.nPublic % 7;

    while (done + 7 <= self.nPublic) {
        val tmp: slice = PrivaPurchaseAuthVerifier.blsG1Multiexp7(
            self.ic(done + 1),
            PrivaPurchaseAuthVerifier.checkPublicInput(pubInputs.get(done)),
            self.ic(done + 2),
            PrivaPurchaseAuthVerifier.checkPublicInput(pubInputs.get(done + 1)),
            self.ic(done + 3),
            PrivaPurchaseAuthVerifier.checkPublicInput(pubInputs.get(done + 2)),
            self.ic(done + 4),
            PrivaPurchaseAuthVerifier.checkPublicInput(pubInputs.get(done + 3)),
            self.ic(done + 5),
            PrivaPurchaseAuthVerifier.checkPublicInput(pubInputs.get(done + 4)),
            self.ic(done + 6),
            PrivaPurchaseAuthVerifier.checkPublicInput(pubInputs.get(done + 5)),
            self.ic(done + 7),
            PrivaPurchaseAuthVerifier.checkPublicInput(pubInputs.get(done + 6)),
            7,
        );

        if (!haveAcc) {
            acc = tmp;
            haveAcc = true;
        } else {
            acc = PrivaPurchaseAuthVerifier.blsG1Add(acc, tmp);
        }

        done += 7;
    }

    if (rem == 3) {
        val tail: slice = PrivaPurchaseAuthVerifier.blsG1Multiexp3(
            self.ic(done + 1),
            PrivaPurchaseAuthVerifier.checkPublicInput(pubInputs.get(done)),
            self.ic(done + 2),
            PrivaPurchaseAuthVerifier.checkPublicInput(pubInputs.get(done + 1)),
            self.ic(done + 3),
            PrivaPurchaseAuthVerifier.checkPublicInput(pubInputs.get(done + 2)),
            3,
        );

        if (!haveAcc) {
            acc = tail;
            haveAcc = true;
        } else {
            acc = PrivaPurchaseAuthVerifier.blsG1Add(acc, tail);
        }

        done += 3;
    }

    return self.finishGroth16(piA, piB, piC, acc, haveAcc);
}

/// Internal message containing Groth16 proof points and serialized public inputs.
struct (0x3b3cca17) PrivaPurchaseAuthVerifierVerify {
    /// Ordinary cell with exactly three refs: piA, piB, piC.
    proof: cell
    /// Ordinary cell with uint8 length followed by a linear int257 ref chain.
    pubInputs: cell
}

fun PrivaPurchaseAuthVerifier.verifyProof(self, msg: PrivaPurchaseAuthVerifierVerify): bool {
    val (piA, piB, piC) = PrivaPurchaseAuthVerifier.loadCheckedProof(msg.proof);
    val (initialPayload, payloadIsExotic) = msg.pubInputs.beginParseSpecial();
    var payload = initialPayload;

    if (payloadIsExotic || payload.remainingBitsCount() < 8) {
        throw PrivaPurchaseAuthVerifierErrors.InvalidInputs;
    }
    if (payload.loadUint(8) != self.nPublic) {
        throw PrivaPurchaseAuthVerifierErrors.InvalidInputs;
    }
    PrivaPurchaseAuthVerifier.checkPublicInputsPayloadShape(payload);

    return self.verifyPayload(piA, piB, piC, mutate payload);
}
