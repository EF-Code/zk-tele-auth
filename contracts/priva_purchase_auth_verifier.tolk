
import "@stdlib/exotic-cells"

contract PrivaPurchaseAuthVerifier {
  description: "Groth16 verifier generated by export-ton-verifier"
  storage: PrivaPurchaseAuthVerifierStorage
  incomingMessages: PrivaPurchaseAuthVerifierVerify
}

/// This verifier is stateless.
/// It does not provide:
/// - nullifier replay protection;
/// - nonce or query-id protection;
/// - known-root validation;
/// - recipient binding;
/// - chain-id or contract-address domain separation;
/// - state-transition validation.

/// Empty persistent storage; verifier constants are embedded in code.
struct PrivaPurchaseAuthVerifierStorage {}

struct PrivaPurchaseAuthVerifier {
  ic0: slice
  ic1: slice
  ic2: slice
  ic3: slice
  ic4: slice
  ic5: slice
  ic6: slice
  ic7: slice
  ic8: slice
  ic9: slice
  ic10: slice
  ic11: slice
  ic12: slice
  ic13: slice
  ic14: slice
  ic15: slice
  vkGamma2: slice
  vkDelta2: slice
  vkAlpha1: slice
  vkBeta2: slice
  nPublic: int
}

const PrivaPurchaseAuthVerifierMinVerifyValue: coins = 50000000

enum PrivaPurchaseAuthVerifierErrors {
  InvalidInputs = 258,
  IndexOutOfRange = 259,
  WrongProof = 260,
  NotEnoughValue = 261,
}

fun PrivaPurchaseAuthVerifier.create(): PrivaPurchaseAuthVerifier {
  return PrivaPurchaseAuthVerifier {
    ic0: "b770664011520d4a14ac1fd44718e0073c092ab0c0c461ac30412538481af61915036519fd6bc34f2001202b8d6a191d".hexToSlice(),
    ic1: "a779c38b69bf546d320ce881b6bfb310f8a1122bede00ec38e067742dacaccd0cdde43f5e13519d1a171d06a7ce62ed9".hexToSlice(),
